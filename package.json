{
  "name": "nexcode",
  "version": "0.3.0",
  "private": true,
  "description": "Open-source, model-agnostic AI coding agent with an OpenTUI terminal.",
  "license": "MIT",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=26.4.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev:cli": "pnpm --filter @nexcode/cli... build && pnpm --filter @nexcode/cli dev",
    "start:cli": "pnpm --filter @nexcode/cli start",
    "test": "vitest run",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "start:web": "node apps/agent/server.js",
    "dev:web": "node --watch apps/agent/server.js",
    "check:web": "node --check apps/agent/server.js && node --check apps/agent/knowledge.js && node --check apps/agent/bookmarks.js && node --check apps/web/app.js"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "turbo": "^2.6.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  }
}
