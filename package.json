{
  "name": "nexo",
  "version": "0.4.0",
  "private": true,
  "description": "Local-first AI workspace with a browser UI and cross-platform terminal agent.",
  "license": "MIT",
  "packageManager": "pnpm@10.20.0",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "build": "turbo run build",
    "dev": "pnpm --filter @nexo/agent... build && pnpm --filter @nexo/agent start",
    "start": "pnpm --filter @nexo/agent start",
    "dev:agent": "pnpm --filter @nexo/agent dev",
    "dev:cli": "pnpm --filter @nexcode/cli... build && pnpm --filter @nexcode/cli dev",
    "start:cli": "pnpm --filter @nexcode/cli start",
    "test": "vitest run",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "turbo": "^2.6.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  }
}