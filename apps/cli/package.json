{
  "name": "@nexcode/cli",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "bin": { "nexcode": "./dist/index.js" },
  "scripts": {
    "dev": "bun src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "bun dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e "import('node:fs').then(fs => fs.rmSync('dist', {recursive:true, force:true}))""
  },
  "dependencies": {
    "@nexcode/core": "workspace:*",
    "@nexcode/providers": "workspace:*",
    "@opentui/core": "^0.8.2",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^5.9.3"
  }
}