{
  "name": "@nexcode/cli",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "bin": {
    "nexo-terminal": "./dist/index.js"
  },
  "scripts": {
    "dev": "pnpm run build && node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"import('node:fs').then(fs => fs.rmSync('dist', {recursive:true, force:true}))\""
  },
  "dependencies": {
    "@nexcode/core": "workspace:*",
    "@nexcode/providers": "workspace:*",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^5.9.3"
  },
  "description": "Legacy terminal interface retained as an optional companion."
}
