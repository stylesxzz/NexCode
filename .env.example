# Choose: nvidia | openai | anthropic | google | ollama | openai-compatible
NEXCODE_PROVIDER=nvidia
NEXCODE_MODEL=meta/llama-3.3-70b-instruct
NEXCODE_API_KEY=
NEXCODE_BASE_URL=https://integrate.api.nvidia.com/v1

# Provider-specific keys (use one or configure a compatible endpoint)
NVIDIA_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Ollama example:
# NEXCODE_PROVIDER=ollama
# NEXCODE_MODEL=qwen2.5-coder:7b
# NEXCODE_BASE_URL=http://localhost:11434/v1
